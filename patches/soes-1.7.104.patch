+bool Settings::ForceEquipHookOn17() {
+    static std::optional<bool> result;
+
+    if (!result.has_value()) {
+        // Independent of logging: this is a safety switch, not a debug option.
+        result = Instance()->GetBoolean("Gameplay", "ForceEquipHookOn17", SettingsDefaults::ForceEquipHookOn17);
+        EXTRALOG(info, "ForceEquipHookOn17 set as {}", result.value());
+    }
+
+    return result.has_value() ? result.value() : SettingsDefaults::ForceEquipHookOn17;
+}
