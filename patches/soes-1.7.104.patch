 Scriptname SkyOutEquSysQuickslotEffect extends activemagiceffect
 
+; Quick-slot outfit picker.
+;
+; Favourite outfits can be grouped into categories by naming them with "/" as a separator:
+;   "Leather/Ranger"          -> category "Leather", entry "Ranger"
+;   "Armor/Heavy/Steel Plate" -> "Armor" > "Heavy" > "Steel Plate"
+; Outfits without "/" are listed at the top level, after the categories.
+; Categories are matched ignoring capitalisation (a Papyrus property), so "leather/x" and
+; "Leather/y" end up in the same category. Nesting is capped at MaxDepth() levels; any deeper
+; separators stay part of the entry label.
+
+Int Function MaxDepth()
+   Return 4
+EndFunction
+
+; Strips leading/trailing spaces so "Leather / Ranger" works like "Leather/Ranger".
+String Function Trim(String s)
+   Int iLen = StringUtil.GetLength(s)
+   Int iStart = 0
+   While iStart < iLen && StringUtil.GetNthChar(s, iStart) == " "
+      iStart += 1
+   EndWhile
+   Int iEnd = iLen
+   While iEnd > iStart && StringUtil.GetNthChar(s, iEnd - 1) == " "
+      iEnd -= 1
+   EndWhile
+   If iEnd <= iStart
+      Return ""
+   EndIf
+   Return StringUtil.Substring(s, iStart, iEnd - iStart)
+EndFunction
+
 Event OnEffectStart(Actor akCaster, Actor akTarget)
    bool isPCTracked = SkyrimOutfitEquipmentSystemNativeFuncs.HasActor(Game.GetPlayer())
 
