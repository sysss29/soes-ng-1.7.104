+
+    // Direct child categories of a_path ("" = top level), as names (not full paths), sorted.
+    std::vector<RE::BSFixedString> ListOutfitSubcategories(RE::BSScript::IVirtualMachine*, std::uint32_t, RE::StaticFunctionTag*,
+                                                           RE::BSFixedString a_path) {
+        using namespace OutfitCategories;
+        auto path = ParsePath(a_path.data());
