+    // Full names of all outfits whose name contains a_filter (case-insensitive), sorted.
+    std::vector<RE::BSFixedString> SearchOutfits(RE::BSScript::IVirtualMachine*, std::uint32_t, RE::StaticFunctionTag*,
+                                                 RE::BSFixedString a_filter) {
+        using namespace OutfitCategories;
+        auto lower = [](std::string s) {
+            std::transform(s.begin(), s.end(), s.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+            return s;
+        };
+        auto needle = lower(Trim(a_filter.data()));
+        std::vector<std::string> found;
+        for (const auto& name : AllOutfitNames())
+            if (needle.empty() || lower(name).find(needle) != std::string::npos) found.push_back(name);
+        std::sort(found.begin(), found.end(), NaturalLess);
+        std::vector<RE::BSFixedString> result;
+        for (const auto& name : found) result.emplace_back(name.c_str());
+        return result;
+    }
+
+    // Every category path in use (each level, e.g. "Armor" and "Armor/Heavy"), sorted.
+    std::vector<RE::BSFixedString> ListAllOutfitCategories(RE::BSScript::IVirtualMachine*, std::uint32_t, RE::StaticFunctionTag*) {
+        using namespace OutfitCategories;
+        std::vector<std::string> paths;
+        for (const auto& name : AllOutfitNames()) {
+            auto parsed = Parse(name);
+            for (std::size_t depth = 1; depth <= parsed.categories.size(); ++depth)
+                AddUnique(paths, JoinPath(parsed.categories, depth));
+        }
+        std::sort(paths.begin(), paths.end(), NaturalLess);
+        std::vector<RE::BSFixedString> result;
+        for (const auto& path : paths) result.emplace_back(path.c_str());
+        return result;
+    }
