+            auto parsed = Parse(name);
+            if (parsed.categories.size() > path.size() && HasPrefix(parsed.categories, path))
+                AddUnique(children, parsed.categories[path.size()]);
+        }
+        std::sort(children.begin(), children.end(), NaturalLess);
+        std::vector<RE::BSFixedString> result;
+        for (const auto& child : children) result.emplace_back(child.c_str());
