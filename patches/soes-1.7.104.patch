+    }
+
+    // Number of outfits in a category, including its subcategories.
+    std::int32_t CountOutfitsInCategory(RE::BSScript::IVirtualMachine*, std::uint32_t, RE::StaticFunctionTag*,
+                                        RE::BSFixedString a_path) {
+        using namespace OutfitCategories;
+        auto path = ParsePath(a_path.data());
