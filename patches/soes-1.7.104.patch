+
+    // Full names of the outfits directly in a_path (not in its subcategories), sorted by label.
+    std::vector<RE::BSFixedString> ListOutfitsInCategory(RE::BSScript::IVirtualMachine*, std::uint32_t, RE::StaticFunctionTag*,
+                                                         RE::BSFixedString a_path) {
+        using namespace OutfitCategories;
+        auto path = ParsePath(a_path.data());
+        std::vector<std::pair<std::string, std::string>> found;  // label, full name
+        for (const auto& name : AllOutfitNames()) {
+            auto parsed = Parse(name);
+            if (parsed.categories.size() == path.size() && HasPrefix(parsed.categories, path))
+                found.emplace_back(parsed.label, name);
+        }
+        std::sort(found.begin(), found.end(), [](const auto& a, const auto& b) { return NaturalLess(a.first, b.first); });
