+
+Function RefreshBrowserLists()
+   If _sBrowserFilter
+      _sBrowserSubcats = Utility.CreateStringArray(0)
+      _sBrowserOutfits = SkyrimOutfitEquipmentSystemNativeFuncs.SearchOutfits(_sBrowserFilter)
+   Else
+      _sBrowserSubcats = SkyrimOutfitEquipmentSystemNativeFuncs.ListOutfitSubcategories(_sBrowserPath)
+      If _sBrowserPath && _sBrowserSubcats.Length == 0 && SkyrimOutfitEquipmentSystemNativeFuncs.CountOutfitsInCategory(_sBrowserPath) == 0
+         _sBrowserPath = "" ; category no longer exists (e.g. its last outfit was moved away)
+         _sBrowserSubcats = SkyrimOutfitEquipmentSystemNativeFuncs.ListOutfitSubcategories(_sBrowserPath)
+      EndIf
+      _sBrowserOutfits = SkyrimOutfitEquipmentSystemNativeFuncs.ListOutfitsInCategory(_sBrowserPath)
+   EndIf
+EndFunction
+
+String Function BrowserChildPath(String asChild)
+   If _sBrowserPath
+      Return _sBrowserPath + "/" + asChild
+   EndIf
+   Return asChild
+EndFunction
+
+String Function BrowserParentPath(String asPath)
+   ; Everything before the last "/" ("" at the top level).
+   Int iLast = -1
+   Int iFound = StringUtil.Find(asPath, "/")
+   While iFound >= 0
+      iLast = iFound
+      iFound = StringUtil.Find(asPath, "/", iFound + 1)
+   EndWhile
+   If iLast < 0
+      Return ""
+   EndIf
+   Return StringUtil.Substring(asPath, 0, iLast)
+EndFunction
+
+Bool Function IsSelected(String asName)
+   If !asName || _sSelection.Length == 0
+      Return False
+   EndIf
+   Return _sSelection.Find(asName) >= 0
+EndFunction
+
+Function SetSelected(String asName, Bool abSelected)
+   If !asName
+      Return
+   EndIf
+   If _sSelection.Length == 0
+      _sSelection = Utility.CreateStringArray(32)
+   EndIf
+   Int i = _sSelection.Find(asName)
+   If abSelected && i < 0
+      Int iFree = _sSelection.Find("")
+      If iFree < 0
+         iFree = _sSelection.Length
+         _sSelection = Utility.ResizeStringArray(_sSelection, _sSelection.Length + 32)
+      EndIf
+      _sSelection[iFree] = asName
+   ElseIf !abSelected
+      While i >= 0
+         _sSelection[i] = ""
+         i = _sSelection.Find(asName)
+      EndWhile
+   EndIf
+EndFunction
+
+String[] Function SelectedNames()
+   Int iCount = 0
+   Int i = 0
+   While i < _sSelection.Length
+      If _sSelection[i]
+         iCount += 1
+      EndIf
+      i += 1
+   EndWhile
+   String[] sResult = Utility.CreateStringArray(iCount)
+   Int j = 0
+   i = 0
+   While i < _sSelection.Length
+      If _sSelection[i]
+         sResult[j] = _sSelection[i]
+         j += 1
+      EndIf
+      i += 1
+   EndWhile
+   Return sResult
+EndFunction
+
+Function ClearSelection()
+   _sSelection = Utility.CreateStringArray(32)
+EndFunction
+
+String Function ImportCategoryDisplay()
+   If _sImportCategory == "<mod>"
+      Return "Named after the mod"
+   ElseIf !_sImportCategory
+      Return "Top level"
+   EndIf
+   Return _sImportCategory
+EndFunction
+
+; New outfits created while browsing a category go into that category.
+String Function NameInCurrentCategory(String asName)
+   If _sBrowserPath && !_sBrowserFilter && StringUtil.Find(asName, "/") < 0
+      Return _sBrowserPath + "/" + asName
+   EndIf
+   Return asName
 EndFunction
 
