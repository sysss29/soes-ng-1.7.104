+    // ------------------------------------------------------------------------------------------
+    // 1.7.104 rebuild: outfit categories.
+    // An outfit named "Armor/Heavy/Steel" sits in category "Armor/Heavy" with label "Steel".
+    // Segments are trimmed, empty segments ignored, matching ignores case (like Papyrus), and at
+    // most kMaxCategoryDepth levels are used (deeper '/' stay in the label). This mirrors the
+    // quick-slot menu script so both group outfits identically.
+    // ------------------------------------------------------------------------------------------
+    namespace OutfitCategories {
+        constexpr std::size_t kMaxCategoryDepth = 4;
+
+        std::string Trim(std::string_view a_str) {
+            auto begin = a_str.find_first_not_of(' ');
+            if (begin == std::string_view::npos) return {};
+            auto end = a_str.find_last_not_of(' ');
+            return std::string(a_str.substr(begin, end - begin + 1));
+        }
+
+        bool IEquals(const std::string& a_lhs, const std::string& a_rhs) {
+            return a_lhs.size() == a_rhs.size() && _stricmp(a_lhs.c_str(), a_rhs.c_str()) == 0;
+        }
+
+        bool NaturalLess(const std::string& a_lhs, const std::string& a_rhs) {
+            return cobb::utf8::naturalcompare(a_lhs, a_rhs) > 0;  // same convention as NaturalSort_ASCII
+        }
+
+        struct Parsed {
+            std::vector<std::string> categories;
+            std::string label;
+        };
+
+        Parsed Parse(const std::string& a_fullName) {
+            std::vector<std::string> parts;
+            std::size_t start = 0;
+            while (true) {
+                auto slash = a_fullName.find('/', start);
+                parts.push_back(a_fullName.substr(start, slash == std::string::npos ? std::string::npos : slash - start));
+                if (slash == std::string::npos) break;
+                start = slash + 1;
+            }
+            Parsed result;
+            std::size_t depth = parts.size() - 1;
+            if (depth > kMaxCategoryDepth) depth = kMaxCategoryDepth;
+            for (std::size_t i = 0; i < depth; ++i) {
+                auto segment = Trim(parts[i]);
+                if (!segment.empty()) result.categories.push_back(segment);
+            }
+            for (std::size_t i = depth; i < parts.size(); ++i) {
+                if (!result.label.empty()) result.label += "/";
+                result.label += Trim(parts[i]);
+            }
+            if (result.label.empty()) result.label = a_fullName;
+            return result;
+        }
+
+        std::vector<std::string> ParsePath(const std::string& a_path) {
+            std::vector<std::string> segments;
+            if (Trim(a_path).empty()) return segments;
+            return Parse(a_path + "/x").categories;
+        }
+
+        std::string JoinPath(const std::vector<std::string>& a_segments, std::size_t a_count) {
+            std::string path;
+            for (std::size_t i = 0; i < a_count && i < a_segments.size(); ++i) {
+                if (!path.empty()) path += "/";
+                path += a_segments[i];
+            }
+            return path;
+        }
+
+        // True if a_categories starts with a_prefix (case-insensitive, segment by segment).
+        bool HasPrefix(const std::vector<std::string>& a_categories, const std::vector<std::string>& a_prefix) {
+            if (a_categories.size() < a_prefix.size()) return false;
+            for (std::size_t i = 0; i < a_prefix.size(); ++i)
+                if (!IEquals(a_categories[i], a_prefix[i])) return false;
+            return true;
+        }
+
+        std::vector<std::string> AllOutfitNames(bool a_favoritesOnly = false) {
+            std::vector<std::string> names;
+            ArmorAddonOverrideService::GetInstance().getOutfitNames(names, a_favoritesOnly);
+            return names;
+        }
+
+        void AddUnique(std::vector<std::string>& a_list, const std::string& a_value) {
+            for (const auto& existing : a_list)
+                if (IEquals(existing, a_value)) return;
+            a_list.push_back(a_value);
+        }
+
+        std::string BuildName(const std::vector<std::string>& a_categories, const std::string& a_label) {
+            std::string name = JoinPath(a_categories, a_categories.size());
+            if (!name.empty()) name += "/";
+            return name + a_label;
+        }
+
+        // Renames a_old to a_desired, appending " (2)", " (3)", ... if that name is taken.
+        // Returns the final name, or "" if the rename failed.
+        std::string RenameUnique(const std::string& a_old, const std::string& a_desired) {
+            if (a_old == a_desired) return a_old;
+            auto& service = ArmorAddonOverrideService::GetInstance();
+            std::string candidate = a_desired;
+            for (int n = 2; service.hasOutfit(candidate.c_str()) && n < 1000; ++n)
+                candidate = fmt::format("{} ({})", a_desired, n);
