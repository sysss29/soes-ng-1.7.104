+        // Moves every outfit in category a_old (and its subcategories) under a_new, keeping the
+        // sub-structure. a_new may be an existing category (merge) or "" (top level).
+        std::int32_t RecategorizeTree(const std::vector<std::string>& a_old, const std::vector<std::string>& a_new) {
+            if (a_old.empty()) return 0;
